# Copy to urls.env and fill real values.
# Used by run_uplinks_full.py (autoload by default).

# NetBox
NETBOX_URL="https://netbox.example.com"
NETBOX_TOKEN="replace-me"
NETBOX_TAG="border"

# Zabbix API
ZABBIX_URL="https://zabbix.example.com/api_jsonrpc.php"
ZABBIX_TOKEN="replace-me"
ZABBIX_FRONTEND_URL="https://zabbix.example.com"

# Grafana (optional, needed for --grafana / --grafana-api flows)
GRAFANA_URL="https://grafana.example.com"
GRAFANA_API_KEY="replace-me"

# SSH collection (needed when using --fetch / --refresh)
SSH_USERNAME="replace-me"
SSH_PASSWORD="replace-me"
SSH_HOST_SUFFIX=".3hc.io"
PARALLEL_DEVICES="6"
